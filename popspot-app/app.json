{
  "expo": {
    "name": "팝스팟",
    "slug": "popspot-app",
    "scheme": "popspot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.co.popspot"
    },
    "android": {
      "package": "kr.co.popspot",
      "adaptiveIcon": {
        "backgroundColor": "#c2f970",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/WantedSans-Regular.ttf",
            "./assets/fonts/WantedSans-SemiBold.ttf",
            "./assets/fonts/WantedSans-Bold.ttf",
            "./assets/fonts/WantedSans-ExtraBold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      "@maplibre/maplibre-react-native"
    ]
  }
}
